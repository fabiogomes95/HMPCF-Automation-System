# ─── Migração SQLite → PostgreSQL — HMPCF ─────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA commite o .env no git — ele contém credenciais de banco.
#
# Uso:
#   cp .env.example .env
#   # edite .env com seus valores reais
#   python migrate_to_postgres.py --dry-run
#   python migrate_to_postgres.py

# ── Origem (SQLite legado) ─────────────────────────────────────────────────────
# Caminho do hospital.db relativo ao script (um nível acima de hmcpf-system/)
SQLITE_PATH=../hospital.db

# ── Destino (PostgreSQL novo HMPCF) ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hmpcf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui

# ── Configurações do script ────────────────────────────────────────────────────

# Arquivo de log gerado pela migração (caminho relativo ao script)
LOG_FILE=migration.log

# Quantidade de registros por lote de INSERT (execute_values)
# Valores menores usam menos memória; maiores são mais rápidos
BATCH_SIZE=500
