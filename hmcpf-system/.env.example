# ─── Migração SQLite → PostgreSQL — HMPCF ────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA commite o .env no git — ele contém senha de banco.

# Origem (SQLite — caminho relativo ao script)
SQLITE_PATH=../hospital.db

# Destino (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hmpcf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui

# Arquivo de log gerado pelo script
LOG_FILE=migration.log

# Registros por lote de INSERT (padrão: 500)
BATCH_SIZE=500
