# Python
__pycache__/
*.py[cod]
*.pyo
.venv/

# Node / Vite
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Cópia local de testes de design (nunca commitar)
frontend-teste/

# Segredos — nunca commitar
.env
**/.env

# Misc
*.log
.DS_Store

# SQLite databases (legacy)
*.db
*.db-shm
*.db-wal

# Legado — arquivos ignorados que foram movidos para legado/
legado/venv/
legado/credentials.json
legado/__pycache__/
opencode/

# Planilhas com dados de pacientes
*.csv

# Lotes BPA (CNS/CPF de pacientes — nunca commitar)
dashboard/bpa_lotes/*.txt
!dashboard/bpa_lotes/.gitkeep
bpa/bpa_lotes/*.txt
!bpa/bpa_lotes/.gitkeep

# Saida de inspecao do Firebird (dados reais de pacientes — nunca commitar)
scripts/bpa/inspecao.txt

# Exports reais do BPA Magnetico (dados de pacientes — nunca commitar)
*.ABR
*.PRN
*.MAR

# Binario do NSSM (baixado por maquina, nao e codigo)
nssm/

# Arquivo de lock/sincronização gerado pelo SO (nome ilegível)
dashboard/.*00050000000716d2630ff9e1aa84aad6
