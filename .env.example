# ============================================================
# HMPCF — Configuração de Migração
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versionar o .env com senha real.
# ============================================================

# Caminho do banco SQLite legado (somente leitura)
SQLITE_PATH=../hospital.db

# PostgreSQL destino
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hmpcf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui

# Pasta de backups automáticos
BACKUP_DIR=./backup

# Arquivo de log completo
LOG_FILE=./migration_official.log

# Registros por batch insert (padrão: 500)
BATCH_SIZE=500
