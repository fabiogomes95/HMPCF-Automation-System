# Configuração do BPA local deste notebook (bpa/.env — fora do git).
# Copie para bpa/.env e preencha. O instalar.ps1 avisa o que estiver faltando.

# Firebird do BPA Magnético (local, offline)
FIREBIRD_PATH=C:\BPA\BPAMAG.GDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=

# Servidor do hospital — usuário só de leitura (pacientes e atendimentos) que
# também grava a cópia dos lotes (tabela bpa_lotes_backup)
POSTGRES_HOST=192.168.1.29
POSTGRES_PORT=5432
POSTGRES_DB=hmpcf
POSTGRES_USER=bpa_leitura
POSTGRES_PASSWORD=

# Lotes de digitação (DD-MM-AAAA.txt) e arquivos BPA gerados
BPA_LOTES_DIR=C:\BPA\bpa_lotes
BPA_SAIDA_DIR=C:\BPA

# Opcionais (tire o # para usar)
# Nome deste notebook no backup dos lotes (padrão: nome do computador)
# BPA_NOTEBOOK=BPA-1
# Porta do BPA local
# BPA_DIGITACAO_PORT=8503
# Endereços do sistema que podem chamar este BPA
# BPA_ORIGENS_PERMITIDAS=http://192.168.1.29:8001,http://desktop-9c4s1co:8001
# 0 desliga a migração automática do dia / a cópia dos lotes no servidor
# BPA_MIGRACAO_AUTO=0
# BPA_BACKUP_LOTES=0
