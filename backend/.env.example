APP_NAME=HMPCF
# development | production
ENVIRONMENT=development

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=hmpcf

# ── Pool de conexões ──────────────────────────────────────────────────────────
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Em produção LAN, frontend e backend são mesma origem → ["*"] é seguro.
# Para restringir: CORS_ORIGINS=["http://192.168.1.100:8001"]
CORS_ORIGINS=["*"]

# ── Testes (nunca apontar para hmpcf) ─────────────────────────────────────────
TEST_POSTGRES_DB=hmpcf_test

# ── Autenticação (opcional — valores abaixo já são o padrão) ──────────────────
# SESSION_COOKIE_NAME=hmpcf_session
# SESSION_TTL_HOURS=12
# Sessão usada quando o login marca "Manter conectado neste computador"
# (terminal fixo da recepção — fica logado até o cookie realmente expirar)
# SESSION_TTL_LEMBRAR_HORAS=8760
# LOGIN_MAX_TENTATIVAS=5
# LOGIN_BLOQUEIO_MINUTOS=15

# Acesso local (http://localhost:8001, terminal fixo da recepção) pula a
# tela de login e usa direto o usuário abaixo. Acesso de outra máquina pela
# rede (ex.: http://192.168.1.29:8001) continua pedindo login normalmente.
# AUTO_LOGIN_LOCAL=true
# AUTO_LOGIN_USERNAME=recepcao
