{
  "productName": "HMPCF",
  "version": "2.0.0",
  "identifier": "com.hmpcf.desktop",
  "build": {
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File ../scripts/start-backend-and-vite.ps1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HMPCF - Sistema Hospitalar",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
