# ──────────────────────────────────────────────────────────────────────────────
# Configurações locais do BPA Flask (bpa/.env)
# Copie este arquivo para "bpa/.env" e ajuste os valores para sua máquina.
# Este arquivo NÃO é versionado (.gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# Pasta onde os lotes de digitação (.txt) serão salvos
BPA_LOTES_DIR=C:\BPA\bpa_lotes

# Pasta onde o arquivo BPA-I final será gerado (deixe em branco para ~/Downloads)
BPA_SAIDA_DIR=C:\BPA

# Host do PostgreSQL (use Desktop-9c4s1co quando rodar o Flask no PC local)
POSTGRES_HOST=Desktop-9c4s1co

# Porta Flask (padrão 8503)
# BPA_DIGITACAO_PORT=8503
