# ==============================================================================
# Banco de dados SQLite contém CPF, CNS, nome, endereço, telefone, etc.
# NUNCA versionar — violação direta da LGPD (Lei 13.709/2018)
*.db
*.sqlite
*.sqlite3

# Logs podem conter informações pessoais
*.log

# Planilhas e exportações com dados de pacientes
*.csv
*.xlsx
*.xls

# Relatórios e PDFs gerados
*.pdf

