APP_NAME=HMPCF
# development | production
ENVIRONMENT=development

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=hmpcf

# ── Pool de conexões ──────────────────────────────────────────────────────────
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Em produção LAN, frontend e backend são mesma origem → ["*"] é seguro.
# Para restringir: CORS_ORIGINS=["http://192.168.1.100:8001"]
CORS_ORIGINS=["*"]

# ── Testes (nunca apontar para hmpcf) ─────────────────────────────────────────
TEST_POSTGRES_DB=hmpcf_test

# ── BPA / Firebird (BPA Magnético) ────────────────────────────────────────────
FIREBIRD_PATH=C:\BPA\BPAMAG.GDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=sua_senha_aqui
# Pasta onde ficam os lotes .txt (Triagem/Digitação/Geração)
BPA_LOTES_DIR=C:\HMPCF-Automation-System\backend\app\data\bpa_lotes
